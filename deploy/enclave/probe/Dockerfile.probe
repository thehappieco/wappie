# The A1 PROBE image (deploy/enclave/probe). It is NEVER released: probe.sh
# builds it with a distinct tag and a throwaway EIF, runs it in --debug-mode
# on the parent (production stopped for the run), and throws it away.
#
# It is the reader image of this commit (deploy/enclave/Dockerfile) with the
# jail check of check-image.sh --jail on top (deploy/enclave/jailcheck, target
# `check`: the A0 escape tests, the §16.13 corpus, the reader's end-to-end
# test), and then only what the probe adds: the runner, its entrypoint, the
# reader stand-in (reader-bench.mjs) and the vsock throughput sink. So the
# jail, the workers, Node and the seccomp profile are the ones that ship.
# build-image.sh builds the three in order:
#   deploy/enclave/probe/build-image.sh <tag>
# or by hand, from the PUBLIC repository root, on arm64:
#   docker build -f deploy/enclave/Dockerfile --build-arg SOURCE_DATE_EPOCH=... -t R .
#   docker build -f deploy/enclave/jailcheck/Dockerfile --target check --build-arg READER_IMAGE=R -t J .
#   docker build -f deploy/enclave/probe/Dockerfile.probe --build-arg JAILCHECK_IMAGE=J -t P .
# Classic Dockerfile syntax only (the parent may run the legacy builder).

ARG JAILCHECK_IMAGE
ARG RUST_IMAGE=rust:1-alpine@sha256:7cc1c22d77d9432f7fe012a70e6d3e555af54c2a6832700ed7d553f1769ae89f

# The A0 vsock throughput sink, static musl.
FROM ${RUST_IMAGE} AS native
RUN apk add --no-cache musl-dev build-base linux-headers
COPY deploy/enclave/probe/tests/vsock-sink.c /tests/vsock-sink.c
RUN cc -static -O2 -Wall -o /vsock-sink /tests/vsock-sink.c

FROM ${JAILCHECK_IMAGE}
# The enclave's memory holds the whole root filesystem, and nitro-cli asks
# for four times the EIF: the check's test tree is cut to what it runs. The
# SDK keeps its runtime dependencies only (it is built already), and the
# worker package's test tree imports the image's own /opt/media/worker
# dependencies, which are the ones the workers run with.
RUN cd /opt/e2e/packages/client \
 && rm -rf node_modules \
 && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && rm -rf /root/.npm \
 && rm -rf /opt/e2e/packages/mcp-http/enclave/media/worker/node_modules \
 && ln -s /opt/media/worker/node_modules /opt/e2e/packages/mcp-http/enclave/media/worker/node_modules
COPY --from=native /vsock-sink /opt/probe/bin/vsock-sink
COPY deploy/enclave/probe/entrypoint-probe.sh deploy/enclave/probe/probe-report.mjs /probe/
COPY deploy/enclave/probe/reader-bench.mjs /opt/e2e/packages/mcp-http/enclave/test/probe-bench.mjs
RUN chmod 0555 /opt/probe/bin/vsock-sink /probe/entrypoint-probe.sh \
 && mkdir -p /run/probe \
 && node --check /probe/probe-report.mjs \
 && node --check /opt/e2e/packages/mcp-http/enclave/test/probe-bench.mjs \
 && sh -n /probe/entrypoint-probe.sh
ENTRYPOINT ["/bin/sh", "/probe/entrypoint-probe.sh"]
CMD []
