# Copy to .env for local development. .env is gitignored; .env.example is not,
# so never put a real credential in this file.
#
# whatserverd reads .env automatically. Real environment variables always win,
# so a stale file cannot override what a deployment passes in.

WS_ENV=dev
WS_HTTP_ADDR=:8080

# Native individual WhatsApp audio/video calls on the existing linked number.
# Enabled by default. Restart the server after changing this setting.
# WS_CALLS_ENABLED=true

# Name registered in WhatsApp's Linked devices for newly paired numbers.
# Standalone servers use whappie; managed hosting uses whappie cloud.
# Existing links keep their registered name; a restart does not rename them.
# WS_WA_DEVICE_NAME=whappie

# Public human signup is opt-in and always confirms the email first.
# Invitation signup continues to work without mail, using the shared code.
# WS_PUBLIC_SIGNUP=false
# WS_APP_URL=https://app.example.com
# Email requires a reachable HTTPS browser origin; localhost/loopback links are rejected.
# WS_SMTP_ADDR=smtp.example.com:587
# WS_SMTP_TLS=starttls          # starttls (587) or implicit (465), always verified TLS
# WS_SMTP_USERNAME=
# WS_SMTP_PASSWORD=
# WS_MAIL_FROM=Wappie <accounts@example.com>
# A dedicated random 32-byte key, hex encoded, enables recovering new invite codes.
# Keep this key in the deployment secret store and include it in secure backups.
# Legacy hash-only invitations can be regenerated, not recovered.
# WS_INVITE_ENCRYPTION_KEY_HEX=

# Behind a reverse proxy, name it so the rate limits see the real client
# address instead of the proxy's. Comma-separated addresses or CIDR blocks.
# Anything not listed here has its X-Forwarded-For ignored.
# WS_TRUSTED_PROXIES=10.0.0.0/8

# Serve /metrics, /healthz and /readyz on a listener of their own, so the
# public port carries only what clients need. Empty keeps them on WS_HTTP_ADDR.
# WS_METRICS_ADDR=127.0.0.1:9090

# --- Logging -----------------------------------------------------------------
# WS_LOG_LEVEL=info          # debug|info|warn|error; identifiers are masked at every level
# WS_LOG_FORMAT=text         # json in prod by default
# WS_LOG_WIRE=false          # whatsmeow's own debug output: every message in the
#                            # clear. Development only; refused when WS_ENV=prod.

# --- Postgres (required) ---------------------------------------------------
# Needs PostgreSQL 18 or newer, for uuidv7().
#
# With `make dev-up` (Docker), use port 5433 -- shifted off the default so it
# cannot collide with a Postgres already running on the machine:
WS_POSTGRES_DSN=postgres://whatserver:dev@localhost:5433/whatserver2?sslmode=disable
#
# Already have Postgres locally? Point at it instead. The role must NOT be a
# superuser: superusers bypass row-level security, which would silently disable
# tenant isolation.
#
#   CREATE ROLE whatserver2_app LOGIN PASSWORD 'dev'
#       NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
#   CREATE DATABASE whatserver2 OWNER whatserver2_app;
#
# WS_POSTGRES_DSN=postgres://whatserver2_app:dev@localhost:5432/whatserver2?sslmode=disable

# Three pools for three workloads. History is capped below live on purpose so a
# 10k-message backfill cannot starve live ingest.
WS_PG_LIVE_CONNS=16
WS_PG_HISTORY_CONNS=4
WS_PG_API_CONNS=16
WS_PG_STATEMENT_TIMEOUT=30s

# --- Object storage (optional until phase 4) -------------------------------
# Media does not exist yet, so these can stay unset. Set all three or none:
# a half-configured store fails at boot rather than at the first upload.
#
# WS_S3_ENDPOINT=http://localhost:9000   # empty means real AWS S3
# WS_S3_REGION=us-east-1
# WS_S3_BUCKET=whatserver2-media
# WS_S3_ACCESS_KEY=whatserver
# WS_S3_SECRET_KEY=devdevdev
# WS_S3_USE_SSL=false
# Ceiling on one attachment. The length in a message is the sender's claim, not
# a measured fact, so this bound is what stops a hostile one filling the disk.
# Accepts a plain number of bytes or a K/M/G suffix.
# WS_MEDIA_MAX_BYTES=256M

# --- Browser clients (optional) --------------------------------------------
# The public server runs headless by default. Private web builds are distributed
# by wappie-cloud; any compatible API/CLI can administer this installation.
# WS_WEB_DIR=/absolute/path/to/private/dist
# Allow the private app to select a remote HTTPS installation in its document CSP.
# WS_WEB_EXTERNAL_SERVERS=false
# Exact comma-separated app origins authorized for HTTP, WebSocket and calling.
# No wildcard. Local HTTP origins are accepted only in development.
# WS_BROWSER_ORIGINS=https://app.wappie.thehappie.co

# --- Passkeys (optional; both values are required to enable) ----------------
# One RP may cover app and console, with an explicit origin allowlist.
# Do not change the RP ID after users register credentials: it is part of their
# authenticator binding and encrypted key envelope. Private keys stay in clients.
# WS_PASSKEY_RP_ID=wappie.thehappie.co
# WS_PASSKEY_ORIGINS=https://app.wappie.thehappie.co,https://console.wappie.thehappie.co
# Local development may use RP localhost and http://localhost:<port> origins.

# --- Hosted assistant connector (optional) -----------------------------------
# The Go half of the remote MCP reader (packages/mcp-http), which runs as a
# separate process on this host. Off by default; when on, all four are required.
# WS_MCP_ENABLED=false
# Where the reader listens. Loopback http only: the relay carries sealed
# bundles and a shared secret, and neither may leave the host.
# WS_MCP_READER_URL=http://127.0.0.1:18093
# Shared with the reader (its WAPPIE_MCP_RELAY_SECRET_FILE). At least 32 bytes
# of randomness; keep it in the deployment secret store, never in this file.
# WS_MCP_RELAY_SECRET=
# Where the reader is served from the internet: https in prod, http localhost
# in development. The console builds the consent completion URL from it.
# WS_MCP_PUBLIC_ORIGIN=https://api.wappie.thehappie.co
# Exact hosts an assistant may redirect to, comma-separated. Must match the
# reader's WAPPIE_MCP_REDIRECT_HOSTS.
# WS_MCP_REDIRECT_HOSTS=claude.ai,chatgpt.com
# Domain-verification token from OpenAI's plugin portal, served verbatim at
# /.well-known/openai-apps-challenge. Leave unset until a submission asks.
# WS_MCP_OPENAI_APPS_CHALLENGE=
# Which readers this server fronts, comma-separated; default hosted. "hosted"
# is the process on this host, configured by the four variables above (and
# only when it is listed). Every other id (^[a-z][a-z0-9]{0,15}$) is an
# attested reader in a Nitro Enclave with its own block below, named by the id
# in upper case. WS_MCP_READER_HOSTED_* is an error.
# WS_MCP_READERS=hosted,enclave
# The enclave's internal listener: https://<host>:<port>, no path, on the
# public origin's host. Verified with the system roots; no proxy, no redirects.
# WS_MCP_READER_ENCLAVE_URL=https://mcp.wappie.thehappie.co:8443
# Where assistants reach the enclave; advertised as endpoints.mcp_server_attested.
# WS_MCP_READER_ENCLAVE_PUBLIC_ORIGIN=https://mcp.wappie.thehappie.co
# HMAC key for both directions: exactly 43 base64url characters (32 random
# bytes), used as written. Generate with
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
# Keep it in the deployment secret store, never in this file.
# WS_MCP_READER_ENCLAVE_SECRET=
# During a rotation only: the next secret, also accepted from the enclave.
# WS_MCP_READER_ENCLAVE_SECRET_NEXT=
# Addresses the enclave's calls come from (the parent's Elastic IP), compared
# with the client address as WS_TRUSTED_PROXIES resolves it.
# WS_MCP_READER_ENCLAVE_PEER=203.0.113.7/32
# Workspaces that may consent to this reader: UUIDs, or the single value *.
# WS_MCP_READER_ENCLAVE_TENANTS=01a08e0e-c546-7db3-9c44-e6352636d330
# Message text, read only inside the enclave reader. The kill switch: false
# (the default) drops every content connection's key within a minute and
# refuses new ones; the consents survive and are renewed when it is back on.
# Requires the enclave reader in WS_MCP_READERS.
# WS_MCP_CONTENT_ENABLED=false
# Workspaces that may consent to content: UUIDs, comma-separated (no *). Each
# must also be in WS_MCP_READER_ENCLAVE_TENANTS. Required when content is
# enabled.
# WS_MCP_CONTENT_TENANTS=01a08e0e-c546-7db3-9c44-e6352636d330

WS_LOG_LEVEL=info
WS_LOG_FORMAT=text
