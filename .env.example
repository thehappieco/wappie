# Copy to .env for local development. .env is gitignored; .env.example is not,
# so never put a real credential in this file.
#
# whatserverd reads .env automatically. Real environment variables always win,
# so a stale file cannot override what a deployment passes in.

WS_ENV=dev
WS_HTTP_ADDR=:8080

# Behind a reverse proxy, name it so the rate limits see the real client
# address instead of the proxy's. Comma-separated addresses or CIDR blocks.
# Anything not listed here has its X-Forwarded-For ignored.
# WS_TRUSTED_PROXIES=10.0.0.0/8

# Serve /metrics, /healthz and /readyz on a listener of their own, so the
# public port carries only what clients need. Empty keeps them on WS_HTTP_ADDR.
# WS_METRICS_ADDR=127.0.0.1:9090

# --- Logging -----------------------------------------------------------------
# WS_LOG_LEVEL=info          # debug|info|warn|error; identifiers are masked at every level
# WS_LOG_FORMAT=text         # json in prod by default
# WS_LOG_WIRE=false          # whatsmeow's own debug output: every message in the
#                            # clear. Development only; refused when WS_ENV=prod.

# --- Postgres (required) ---------------------------------------------------
# Needs PostgreSQL 18 or newer, for uuidv7().
#
# With `make dev-up` (Docker), use port 5433 -- shifted off the default so it
# cannot collide with a Postgres already running on the machine:
WS_POSTGRES_DSN=postgres://whatserver:dev@localhost:5433/whatserver2?sslmode=disable
#
# Already have Postgres locally? Point at it instead. The role must NOT be a
# superuser: superusers bypass row-level security, which would silently disable
# tenant isolation.
#
#   CREATE ROLE whatserver2_app LOGIN PASSWORD 'dev'
#       NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
#   CREATE DATABASE whatserver2 OWNER whatserver2_app;
#
# WS_POSTGRES_DSN=postgres://whatserver2_app:dev@localhost:5432/whatserver2?sslmode=disable

# Three pools for three workloads. History is capped below live on purpose so a
# 10k-message backfill cannot starve live ingest.
WS_PG_LIVE_CONNS=16
WS_PG_HISTORY_CONNS=4
WS_PG_API_CONNS=16
WS_PG_STATEMENT_TIMEOUT=30s

# --- Object storage (optional until phase 4) -------------------------------
# Media does not exist yet, so these can stay unset. Set all three or none:
# a half-configured store fails at boot rather than at the first upload.
#
# WS_S3_ENDPOINT=http://localhost:9000   # empty means real AWS S3
# WS_S3_REGION=us-east-1
# WS_S3_BUCKET=whatserver2-media
# WS_S3_ACCESS_KEY=whatserver
# WS_S3_SECRET_KEY=devdevdev
# WS_S3_USE_SSL=false
# Ceiling on one attachment. The length in a message is the sender's claim, not
# a measured fact, so this bound is what stops a hostile one filling the disk.
# Accepts a plain number of bytes or a K/M/G suffix.
# WS_MEDIA_MAX_BYTES=256M

# --- The browser client (optional) -----------------------------------------
# Where the built web client lives. Serving it is optional: with no build
# present the server says so once at boot and serves the API only.
#
#   make web-install && make web-build
#
# WS_WEB_DIR=web/dist

WS_LOG_LEVEL=info
WS_LOG_FORMAT=text
