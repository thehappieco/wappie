    "securitySchemes": {
      "BearerAuth": {
        "description": "Opaque Wappie session token or API key in Authorization only. Scope read is sufficient; send and full include read. API key whitelist and service grants further restrict access. No tenant override is accepted.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "First read-only archive release. Bearer credentials select a single workspace; clients must validate tenant_id and pin the installation origin. All authenticated data responses and errors use Cache-Control: no-store. Credentials and device permissions are revalidated on every request and immediately before response serialization. Unknown/repeated query parameters are rejected; query strings are limited to 8192 bytes. No sends, downloads, capture/resume commands, plaintext content, private keys or storage object keys are exposed. Existing login, WebSocket and media protocols are documented separately.",
    "title": "Wappie sealed archive REST API",
    "version": "1.0.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.1",
  "paths": {
    "/v1/devices": {
      "get": {
        "description": "Lists devices permitted by ActionView, live account permissions and API key restrictions. Owners may see/manage a device without permission to read its content. There is no pagination on this workspace directory.",
        "operationId": "listDevices",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicesResponse"
                }
              }
            },
            "description": "Sealed archive response. tenant_id is derived from the credential.",
            "headers": {
              "Cache-Control": {
                "description": "Archive responses must not be stored.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
